{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["firefox-webext-browser"],
    "rootDir": "src/extension",
    "outDir": "extension/generated",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src/extension/**/*.ts"]
}
