{
  "manifest_version": 2,
  "name": "Media Stream Bridge",
  "version": "0.1.0",
  "description": "閲覧中のタブが利用するHLSストリームを検出します。",
  "permissions": ["webRequest", "<all_urls>"],
  "background": {
    "page": "background/background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "Media Stream Bridge",
    "default_popup": "popup/popup.html"
  }
}
